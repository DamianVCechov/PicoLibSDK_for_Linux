diff --git a/Clockwork/EMU_TEST/M68K/src/main.cpp b/Clockwork/EMU_TEST/M68K/src/main.cpp
new file mode 100644
index 0000000..f6c3f1c
--- /dev/null
+++ b/Clockwork/EMU_TEST/M68K/src/main.cpp
@@ -0,0 +1,72 @@
+// ****************************************************************************
+//
+//                   Motorola 68000 emulator self-test
+//
+// ****************************************************************************
+
+#include "../include.h"
+
+u8 M68KTestMem[M68K_TEST_MEM_SIZE];
+
+u8 M68KTestRead8(u32 addr)
+{
+	return (addr < M68K_TEST_MEM_SIZE) ? M68KTestMem[addr] : 0xff;
+}
+
+void M68KTestWrite8(u32 addr, u8 data)
+{
+	if (addr < M68K_TEST_MEM_SIZE) M68KTestMem[addr] = data;
+}
+
+void M68KTestPut16(u32 addr, u16 data)
+{
+	M68KTestMem[addr] = (u8)(data >> 8);
+	M68KTestMem[addr + 1] = (u8)data;
+}
+
+void M68KTestPut32(u32 addr, u32 data)
+{
+	M68KTestPut16(addr, (u16)(data >> 16));
+	M68KTestPut16(addr + 2, (u16)data);
+}
+
+Bool M68KSelfTest()
+{
+	sM68K cpu;
+	MemSet(M68KTestMem, 0, sizeof(M68KTestMem));
+	M68KTestPut32(0, 0x1800);
+	M68KTestPut32(4, 0x0100);
+	M68KTestPut32(M68K_VECT_ILLEGAL * 4, 0x0400);
+
+	M68KTestPut16(0x100, 0x70ff); // moveq #-1,d0
+	M68KTestPut16(0x102, 0x6104); // bsr.s 0x108
+	M68KTestPut16(0x104, 0xffff); // illegal instruction
+	M68KTestPut16(0x108, 0x7200); // moveq #0,d1
+	M68KTestPut16(0x10a, 0x4e75); // rts
+
+	M68K_Init(&cpu, M68KTestRead8, M68KTestWrite8);
+	M68K_Reset(&cpu);
+	if ((cpu.pc != 0x100) || (cpu.a[7] != 0x1800)) return False;
+	if ((M68K_Step(&cpu) != M68K_STEP_OK) ||
+		(cpu.d[0] != 0xffffffff) || ((cpu.sr & M68K_SR_N) == 0)) return False;
+	if ((M68K_Step(&cpu) != M68K_STEP_OK) || (cpu.pc != 0x108)) return False;
+	if ((M68K_Step(&cpu) != M68K_STEP_OK) ||
+		(cpu.d[1] != 0) || ((cpu.sr & M68K_SR_Z) == 0)) return False;
+	if ((M68K_Step(&cpu) != M68K_STEP_OK) || (cpu.pc != 0x104)) return False;
+	if ((M68K_Step(&cpu) != M68K_STEP_OK) || (cpu.pc != 0x400)) return False;
+	return True;
+}
+
+int main()
+{
+	Bool ok = M68KSelfTest();
+	DrawClear();
+	DrawText2("Motorola 68000", 40, 80, COL_WHITE);
+	DrawText2(ok ? "SELF-TEST OK" : "SELF-TEST FAILED", ok ? 48 : 16, 128,
+		ok ? COL_GREEN : COL_RED);
+	DrawText("Press Y to return to loader", 48, 200, COL_GRAY);
+	DispUpdate();
+
+	while (KeyGet() != KEY_Y) {}
+	ResetToBootLoader();
+}
